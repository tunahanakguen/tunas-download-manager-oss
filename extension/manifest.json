{
  "manifest_version": 3,
  "name": "TUNAS Download Manager",
  "version": "0.6.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "key": "",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "TUNAS Download Manager", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "background": { "service_worker": "background.js" },
  "content_scripts": [{ "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "all_frames": true, "run_at": "document_idle" }],
  "permissions": ["downloads", "contextMenus", "nativeMessaging", "cookies", "storage", "scripting", "activeTab", "webRequest", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "minimum_chrome_version": "110"
}