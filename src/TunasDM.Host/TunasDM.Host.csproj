<Project Sdk="Microsoft.NET.Sdk">

  <!-- Native-Messaging-Host: vom Browser gestartet, reicht Nachrichten an die App weiter. Bewusst ohne Core-Abhängigkeit. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>TunasDM.Host</AssemblyName>
    <RootNamespace>TunasDM.Host</RootNamespace>
    <ApplicationIcon>..\..\branding\TunasDownloadManager.ico</ApplicationIcon>
    <Product>TUNAS Download Manager</Product>
    <Version>0.7.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TunasDM.Core.Tests" />
  </ItemGroup>

</Project>
