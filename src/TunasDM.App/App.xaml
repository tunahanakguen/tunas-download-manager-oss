<Application x:Class="TunasDM.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:TunasDM.App"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Fluent-Steuerelemente (WPF-UI), dunkel; Akzent wird beim Start auf TUNAS-Weiß gesetzt. -->
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- TUNAS-Logo: weißer Thunfisch im Ring auf schwarzem Grund (branding/). -->
            <BitmapImage x:Key="LogoImage" UriSource="/Resources/TunasLogo.png" />

            <!-- Corporate Design schwarz-weiß; halbtransparent, damit der Mica-Hintergrund durchscheint. -->
            <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="TextSecondary" Color="#C5FFFFFF" />
            <SolidColorBrush x:Key="TextMuted" Color="#87FFFFFF" />
            <SolidColorBrush x:Key="PanelBackground" Color="#0DFFFFFF" />
            <SolidColorBrush x:Key="PanelAlt" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="HoverBackground" Color="#0FFFFFFF" />
            <SolidColorBrush x:Key="BorderBrush" Color="#17FFFFFF" />
            <SolidColorBrush x:Key="Accent" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="OnAccent" Color="#FF000000" />
            <SolidColorBrush x:Key="Green" Color="#FF6CCB5F" />
            <SolidColorBrush x:Key="Danger" Color="#FFFF99A4" />

            <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <local:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
            <local:NullToVisibilityConverter x:Key="NullToVisibility" />
            <local:SizeTextConverter x:Key="SizeText" />

            <!-- Werkzeugleiste: Symbol über Text, ohne Rahmen. -->
            <Style x:Key="ToolButton" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}">
                <!-- Name für Screenreader und UI-Automation aus dem Tooltip. -->
                <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}" />
                <Setter Property="Appearance" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="MinWidth" Value="74" />
                <Setter Property="Margin" Value="0,0,2,0" />
                <Style.Triggers>
                    <!-- Nicht verfügbar: nur blasser, kein grauer Kasten -->
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Opacity" Value="0.38" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ToolLabel" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="Margin" Value="0,4,0,0" />
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>

            <!-- Kleine Symbolknöpfe an der Zeile -->
            <Style x:Key="RowButton" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}">
                <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}" />
                <Setter Property="Appearance" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="6" />
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Margin" Value="2,0,0,0" />
            </Style>

            <Style x:Key="Label" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,0,12,0" />
            </Style>
            <Style x:Key="SectionTitle" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Margin" Value="4,14,0,6" />
            </Style>

            <!-- Karte: abgerundete Fläche wie in Fluent -->
            <Style x:Key="CardBorder" TargetType="{x:Type Border}">
                <Setter Property="Background" Value="{DynamicResource PanelBackground}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>

            <!-- Dialog-Fenster: Fluent mit Mica, ohne Maximieren -->
            <Style x:Key="DialogWindow" TargetType="{x:Type ui:FluentWindow}" BasedOn="{StaticResource {x:Type ui:FluentWindow}}">
                <Setter Property="ExtendsContentIntoTitleBar" Value="True" />
                <Setter Property="WindowBackdropType" Value="Mica" />
                <Setter Property="WindowCornerPreference" Value="Round" />
                <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
