<ui:FluentWindow x:Class="TunasDM.App.Views.CompleteWindow" Style="{StaticResource DialogWindow}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:TunasDM.App.Localization"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{l:T 'Download abgeschlossen'}" Icon="/Resources/TunasDownloadManager.ico" Width="520" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Topmost="True">
    <DockPanel>
        <ui:TitleBar DockPanel.Dock="Top" Title="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" ShowMaximize="False" ShowMinimize="False" CanMaximize="False">
            <ui:TitleBar.Icon><ui:ImageIcon Source="/Resources/TunasLogo.png" /></ui:TitleBar.Icon>
        </ui:TitleBar>
    <StackPanel Margin="20">
        <DockPanel>
            <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="22" Background="{StaticResource Accent}" Margin="0,0,14,0">
                <ui:SymbolIcon Symbol="Checkmark24" FontSize="22" Foreground="{StaticResource OnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="NameText" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="InfoText" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,3,0,0" />
            </StackPanel>
        </DockPanel>
        <TextBlock x:Name="PathText" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,14,0,0" TextWrapping="Wrap" />
        <CheckBox x:Name="DontShow" Content="{l:T 'Dieses Fenster nicht mehr anzeigen'}" Margin="0,14,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{l:T 'Ordner öffnen'}" Margin="0,0,8,0" Click="OnFolder" />
            <Button Content="{l:T 'Öffnen'}" Margin="0,0,8,0" Click="OnOpen" />
            <ui:Button Appearance="Primary" Content="{l:T 'Schließen'}" IsCancel="True" IsDefault="True" Click="OnClose" />
        </StackPanel>
    </StackPanel>
    </DockPanel>
</ui:FluentWindow>
