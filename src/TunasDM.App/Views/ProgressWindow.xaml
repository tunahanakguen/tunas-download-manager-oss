<ui:FluentWindow x:Class="TunasDM.App.Views.ProgressWindow" Style="{StaticResource DialogWindow}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:TunasDM.App.Localization"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:TunasDM.App.Controls"
        Icon="/Resources/TunasDownloadManager.ico" Width="640" Height="520" MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterOwner">
    <DockPanel>
        <ui:TitleBar DockPanel.Dock="Top" Title="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" ShowMaximize="False" ShowMinimize="False" CanMaximize="False">
            <ui:TitleBar.Icon><ui:ImageIcon Source="/Resources/TunasLogo.png" /></ui:TitleBar.Icon>
        </ui:TitleBar>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Url}" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Url}" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="24" />
                <RowDefinition Height="24" />
                <RowDefinition Height="24" />
            </Grid.RowDefinitions>
            <TextBlock Text="{l:T 'Status'}" Style="{StaticResource Label}" />
            <TextBlock Grid.Column="1" Text="{Binding StatusText}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="{l:T 'Dateigröße'}" Style="{StaticResource Label}" />
            <TextBlock Grid.Column="3" Text="{Binding SizeText}" VerticalAlignment="Center" />
            <TextBlock Grid.Row="1" Text="{l:T 'Geschwindigkeit'}" Style="{StaticResource Label}" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SpeedText}" VerticalAlignment="Center" />
            <TextBlock Grid.Row="1" Grid.Column="2" Text="{l:T 'Restzeit'}" Style="{StaticResource Label}" />
            <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding EtaText}" VerticalAlignment="Center" />
            <TextBlock Grid.Row="2" Text="{l:T 'Details'}" Style="{StaticResource Label}" />
            <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding DetailText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </Grid>

        <controls:SegmentBar Grid.Row="2" Height="18" Margin="0,14,0,14" Progress="{Binding Progress}" />

        <TextBlock x:Name="MediaHint" Grid.Row="3" Visibility="Collapsed" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}"
                   Text="{l:T 'Das Video wird mit yt-dlp geladen. Bild und Ton kommen getrennt und werden danach mit ffmpeg zu einer Datei zusammengefügt.'}" />

        <Border x:Name="ConnectionsPanel" Grid.Row="3" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
            <ui:ListView x:Name="Connections" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimary}"
                     >
                <ui:ListView.View>
                    <ui:GridView>
                        <GridViewColumn Header="{l:T 'Nr.'}" Width="50" DisplayMemberBinding="{Binding Number}" />
                        <GridViewColumn Header="{l:T 'Start'}" Width="120" DisplayMemberBinding="{Binding StartText}" />
                        <GridViewColumn Header="{l:T 'Geladen'}" Width="120" DisplayMemberBinding="{Binding DoneText}" />
                        <GridViewColumn Header="{l:T 'Ende'}" Width="120" DisplayMemberBinding="{Binding EndText}" />
                        <GridViewColumn Header="{l:T 'Zustand'}" Width="110" DisplayMemberBinding="{Binding State}" />
                    </ui:GridView>
                </ui:ListView.View>
            </ui:ListView>
        </Border>

        <DockPanel Grid.Row="4" Margin="0,16,0,0">
            <Button DockPanel.Dock="Left" Content="{l:T 'Ordner öffnen'}" Click="OnOpenFolder" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ToggleButton" Content="{l:T 'Pausieren'}" Margin="0,0,8,0" Click="OnToggle" MinWidth="100" />
                <ui:Button Appearance="Primary" Content="{l:T 'Schließen'}" IsCancel="True" Click="OnClose" />
            </StackPanel>
        </DockPanel>
    </Grid>
    </DockPanel>
</ui:FluentWindow>
