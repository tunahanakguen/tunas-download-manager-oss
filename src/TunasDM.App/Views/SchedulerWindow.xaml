<ui:FluentWindow x:Class="TunasDM.App.Views.SchedulerWindow" Style="{StaticResource DialogWindow}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:TunasDM.App.Localization"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{l:T 'Zeitplaner'}" Icon="/Resources/TunasDownloadManager.ico" Width="820" Height="720" MinWidth="720" MinHeight="560"
        WindowStartupLocation="CenterOwner">
    <DockPanel>
        <ui:TitleBar DockPanel.Dock="Top" Title="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" ShowMaximize="False" ShowMinimize="False" CanMaximize="False">
            <ui:TitleBar.Icon><ui:ImageIcon Source="/Resources/TunasLogo.png" /></ui:TitleBar.Icon>
        </ui:TitleBar>

        <DockPanel DockPanel.Dock="Bottom" Margin="20,0,20,18">
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource Danger}" VerticalAlignment="Center" TextWrapping="Wrap" Visibility="Collapsed" />
            <ui:Button DockPanel.Dock="Right" Appearance="Primary" Content="{l:T 'Schließen'}" IsCancel="True" HorizontalAlignment="Right" Click="OnClose" />
        </DockPanel>

        <Grid Margin="20,6,20,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Warteschlangen -->
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="{l:T 'Neu'}" Click="OnAdd" Margin="0,0,8,0" MinWidth="70" />
                    <Button x:Name="RemoveButton" Content="{l:T 'Löschen'}" Click="OnRemove" MinWidth="70" />
                </StackPanel>
                <Border Style="{StaticResource CardBorder}" Padding="4">
                    <ListBox x:Name="QueueList" SelectionChanged="OnQueueSelected" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4,4">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Summary}" Opacity="0.7" FontSize="12" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </DockPanel>

            <!-- Einstellungen der gewählten Warteschlange -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="Editor">
                    <TextBlock Text="{l:T 'Name'}" Style="{StaticResource Label}" Margin="0,0,0,6" />
                    <TextBox x:Name="NameBox" />

                    <Border Style="{StaticResource CardBorder}" Padding="16,12" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="{l:T 'Zeitplan'}" FontWeight="SemiBold" Margin="0,0,0,10" />
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="StartEnabled" Content="{l:T 'Automatisch starten um'}" Checked="OnScheduleToggled" Unchecked="OnScheduleToggled" />
                                <TextBox x:Name="StartTimeBox" Width="80" Margin="10,0,0,0" ToolTip="{l:T 'Uhrzeit, z. B. 23:00'}" />
                            </StackPanel>
                            <StackPanel x:Name="RepeatPanel" Margin="28,10,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <RadioButton x:Name="OnceOption" GroupName="Repeat" Content="{l:T 'Einmal am'}" Checked="OnRepeatChanged" />
                                    <DatePicker x:Name="OnceDate" Margin="10,0,0,0" Width="150" />
                                </StackPanel>
                                <RadioButton x:Name="DailyOption" GroupName="Repeat" Content="{l:T 'Täglich'}" Margin="0,0,0,6" Checked="OnRepeatChanged" />
                                <RadioButton x:Name="DaysOption" GroupName="Repeat" Content="{l:T 'An diesen Tagen:'}" Checked="OnRepeatChanged" />
                                <WrapPanel x:Name="DaysPanel" Margin="28,6,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <CheckBox x:Name="StopEnabled" Content="{l:T 'Anhalten um'}" Checked="OnScheduleToggled" Unchecked="OnScheduleToggled" />
                                <TextBox x:Name="StopTimeBox" Width="80" Margin="10,0,0,0" ToolTip="{l:T 'Uhrzeit, z. B. 07:00'}" />
                            </StackPanel>
                            <TextBlock Text="{l:T 'Angehaltene Downloads warten danach wieder in der Warteschlange. War TUNAS zur Startzeit geschlossen, wird der Start nicht nachgeholt.'}"
                                       Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" Padding="16,12" Margin="0,12,0,0">
                        <StackPanel>
                            <CheckBox x:Name="SyncBox" Content="{l:T 'Synchronisieren: fertige Dateien bei jedem Start auf Änderungen prüfen'}" />
                            <TextBlock Text="{l:T 'Geänderte Dateien lädt TUNAS neu; die alte Fassung wird erst ersetzt, wenn die neue vollständig ist. Mit einem täglichen Zeitplan bleiben die Dateien so automatisch aktuell.'}"
                                       Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap" Margin="28,4,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" Padding="16,12" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{l:T 'Gleichzeitig laden'}" Style="{StaticResource Label}" />
                            <ComboBox Grid.Column="1" x:Name="ParallelBox" Width="120" HorizontalAlignment="Left" />
                            <TextBlock Grid.Row="2" Text="{l:T 'Wiederholungen bei Fehlern'}" Style="{StaticResource Label}" />
                            <ComboBox Grid.Row="2" Grid.Column="1" x:Name="RetriesBox" Width="120" HorizontalAlignment="Left" />
                            <TextBlock Grid.Row="4" Text="{l:T 'Wenn fertig'}" Style="{StaticResource Label}" />
                            <ComboBox Grid.Row="4" Grid.Column="1" x:Name="AfterBox" Width="260" HorizontalAlignment="Left" SelectionChanged="OnAfterChanged">
                                <ComboBoxItem Content="{l:T 'Nichts tun'}" />
                                <ComboBoxItem Content="{l:T 'TUNAS beenden'}" />
                                <ComboBoxItem Content="{l:T 'Energiesparmodus'}" />
                                <ComboBoxItem Content="{l:T 'Ruhezustand'}" />
                                <ComboBoxItem Content="{l:T 'Computer herunterfahren'}" />
                                <ComboBoxItem Content="{l:T 'Programm starten …'}" />
                            </ComboBox>
                            <Grid Grid.Row="5" Grid.Column="1" x:Name="ProgramPanel" Margin="0,8,0,0" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="6" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ui:TextBox x:Name="ProgramBox" PlaceholderText="{l:T 'Programm, Skript oder Datei'}" />
                                <ui:Button Grid.Column="1" Content="…" Width="40" Margin="8,0,0,0" Click="OnBrowseProgram" ToolTip="{l:T 'Programm wählen'}" />
                                <ui:TextBox Grid.Row="2" Grid.ColumnSpan="2" x:Name="ArgumentsBox" PlaceholderText="{l:T 'Argumente (optional)'}" />
                            </Grid>
                        </Grid>
                    </Border>

                    <DockPanel Margin="0,16,0,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="StartButton" Content="{l:T 'Jetzt starten'}" Click="OnStartNow" Margin="0,0,8,0" />
                            <Button x:Name="StopButton" Content="{l:T 'Anhalten'}" Click="OnStopNow" />
                        </StackPanel>
                        <TextBlock x:Name="QueueInfo" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </DockPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</ui:FluentWindow>
