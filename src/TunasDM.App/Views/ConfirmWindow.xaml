<ui:FluentWindow x:Class="TunasDM.App.Views.ConfirmWindow" Style="{StaticResource DialogWindow}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:TunasDM.App.Localization"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{l:T 'TUNAS Download Manager'}" Icon="/Resources/TunasDownloadManager.ico" Width="460" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel>
        <ui:TitleBar DockPanel.Dock="Top" Title="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" ShowMaximize="False" ShowMinimize="False" CanMaximize="False">
            <ui:TitleBar.Icon><ui:ImageIcon Source="/Resources/TunasLogo.png" /></ui:TitleBar.Icon>
        </ui:TitleBar>
    <StackPanel Margin="20">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" LineHeight="20" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="NoButton" Content="{l:T 'Abbrechen'}" IsCancel="True" Margin="0,0,8,0" />
            <ui:Button Appearance="Primary" x:Name="YesButton" Content="{l:T 'Ja'}" IsDefault="True" MinWidth="80" Click="OnYes" />
        </StackPanel>
    </StackPanel>
    </DockPanel>
</ui:FluentWindow>
