<ui:FluentWindow x:Class="TunasDM.App.Views.LinksWindow" Style="{StaticResource DialogWindow}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:TunasDM.App.Localization"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{l:T 'Links von der Seite'}" Icon="/Resources/TunasDownloadManager.ico" Width="760" Height="560" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterScreen" Topmost="True">
    <DockPanel>
        <ui:TitleBar DockPanel.Dock="Top" Title="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" ShowMaximize="False" ShowMinimize="False" CanMaximize="False">
            <ui:TitleBar.Icon><ui:ImageIcon Source="/Resources/TunasLogo.png" /></ui:TitleBar.Icon>
        </ui:TitleBar>
    <DockPanel Margin="20">
        <TextBlock DockPanel.Dock="Top" x:Name="Header" FontSize="15" FontWeight="SemiBold" />
        <TextBlock DockPanel.Dock="Top" x:Name="PageText" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,3,0,12" TextTrimming="CharacterEllipsis" />

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{l:T 'Alle'}" Padding="10,4" Margin="8,0,0,0" Click="OnAll" />
                <Button Content="{l:T 'Keine'}" Padding="10,4" Margin="8,0,0,0" Click="OnNone" />
            </StackPanel>
            <TextBlock Text="{l:T 'Endungen'}" Style="{StaticResource Label}" />
            <TextBox x:Name="FilterBox" TextChanged="OnFilterChanged"
                     ToolTip="{l:T 'Nur Links mit diesen Endungen anhaken, z. B. „zip pdf mp4“. Leer = alle Dateien mit bekannter Endung.'}" />
        </DockPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <Button DockPanel.Dock="Left" Content="{l:T 'Abbrechen'}" IsCancel="True" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{l:T 'In die Warteschlange'}" Margin="0,0,8,0" Click="OnQueue" />
                <ui:Button Appearance="Primary" x:Name="StartButton" Content="{l:T 'Laden'}" IsDefault="True" Click="OnStart" />
            </StackPanel>
        </DockPanel>

        <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="6">
            <ListBox x:Name="List" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Selected}" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Url}" Foreground="{StaticResource TextMuted}" FontSize="11" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </DockPanel>
    </DockPanel>
</ui:FluentWindow>
