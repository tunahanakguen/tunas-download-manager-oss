<ui:FluentWindow x:Class="TunasDM.App.Views.GrabberWindow" Style="{StaticResource DialogWindow}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:TunasDM.App.Localization"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{l:T 'Site-Grabber'}" Icon="/Resources/TunasDownloadManager.ico" Width="620" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="True"
        FocusManager.FocusedElement="{Binding ElementName=UrlBox}">
    <DockPanel>
        <ui:TitleBar DockPanel.Dock="Top" Title="{l:T 'Site-Grabber'}" ShowMaximize="False" ShowMinimize="False" CanMaximize="False">
            <ui:TitleBar.Icon><ui:ImageIcon Source="/Resources/TunasLogo.png" /></ui:TitleBar.Icon>
        </ui:TitleBar>
        <StackPanel Margin="20,4,20,20">
            <TextBlock Text="{l:T 'Durchsucht eine Website und sammelt die Links auf Dateien – zum Auswählen und Laden.'}"
                       Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,14" />

            <Grid x:Name="Form">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="{l:T 'Startseite'}" Style="{StaticResource Label}" />
                <ui:TextBox Grid.Column="1" x:Name="UrlBox" PlaceholderText="{l:T 'https://example.com/downloads/'}" TextChanged="OnUrlChanged" />

                <TextBlock Grid.Row="2" Text="{l:T 'Dateitypen'}" Style="{StaticResource Label}" />
                <ComboBox Grid.Row="2" Grid.Column="1" x:Name="PresetBox" SelectionChanged="OnPresetChanged" />
                <ui:TextBox Grid.Row="4" Grid.Column="1" x:Name="ExtensionsBox" PlaceholderText="{l:T 'Endungen, z. B. pdf zip mp3 – leer = alle Dateien'}" />

                <TextBlock Grid.Row="6" Text="{l:T 'Tiefe'}" Style="{StaticResource Label}" />
                <ComboBox Grid.Row="6" Grid.Column="1" x:Name="DepthBox" Width="260" HorizontalAlignment="Left" />

                <TextBlock Grid.Row="8" Text="{l:T 'Höchstens'}" Style="{StaticResource Label}" />
                <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal">
                    <ui:NumberBox x:Name="MaxPagesBox" Width="150" Minimum="1" Maximum="5000" Value="200" SmallChange="50" ClearButtonEnabled="False" />
                    <TextBlock Text="{l:T 'Seiten lesen'}" Style="{StaticResource Label}" Margin="10,0,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="10" Grid.Column="1">
                    <CheckBox x:Name="SameHostBox" Content="{l:T 'Nur Seiten dieser Website besuchen'}" IsChecked="True" />
                    <CheckBox x:Name="BelowBox" Content="{l:T 'Nur Seiten unterhalb des Ordners der Startseite'}" Margin="0,4,0,0" />
                    <CheckBox x:Name="RobotsBox" Content="{l:T 'robots.txt der Website beachten'}" IsChecked="True" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>

            <StackPanel x:Name="ProgressPanel" Margin="0,16,0,0" Visibility="Collapsed">
                <TextBlock x:Name="ProgressText" FontWeight="SemiBold" />
                <TextBlock x:Name="CurrentText" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,4,0,8" TextTrimming="CharacterEllipsis" />
                <ProgressBar IsIndeterminate="True" Height="4" />
            </StackPanel>
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource Danger}" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed" />

            <DockPanel Margin="0,20,0,0">
                <Button x:Name="CancelButton" DockPanel.Dock="Left" Content="{l:T 'Abbrechen'}" IsCancel="True" Click="OnCancel" />
                <ui:Button x:Name="StartButton" HorizontalAlignment="Right" Appearance="Primary" Content="{l:T 'Durchsuchen'}"
                           Icon="{ui:SymbolIcon Search24}" IsDefault="True" IsEnabled="False" Click="OnStart" />
            </DockPanel>
        </StackPanel>
    </DockPanel>
</ui:FluentWindow>
