<ui:FluentWindow x:Class="TunasDM.App.Views.AddUrlWindow" Style="{StaticResource DialogWindow}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:TunasDM.App.Localization"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{l:T 'URL hinzufügen'}" Icon="/Resources/TunasDownloadManager.ico" Width="560" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FocusManager.FocusedElement="{Binding ElementName=UrlBox}">
    <DockPanel>
        <ui:TitleBar DockPanel.Dock="Top" Title="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" ShowMaximize="False" ShowMinimize="False" CanMaximize="False">
            <ui:TitleBar.Icon><ui:ImageIcon Source="/Resources/TunasLogo.png" /></ui:TitleBar.Icon>
        </ui:TitleBar>
    <StackPanel Margin="20">
        <TextBlock Text="{l:T 'Adresse der Datei'}" Style="{StaticResource Label}" Margin="0,0,0,6" />
        <TextBox x:Name="UrlBox" TextChanged="OnTextChanged" />
        <TextBlock x:Name="Hint" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,6,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="{l:T 'Abbrechen'}" IsCancel="True" Margin="0,0,8,0" />
            <ui:Button Appearance="Primary" x:Name="OkButton" Content="{l:T 'Weiter'}" IsDefault="True" IsEnabled="False" Click="OnOk" />
        </StackPanel>
    </StackPanel>
    </DockPanel>
</ui:FluentWindow>
