<ui:FluentWindow x:Class="TunasDM.App.Views.UpdateAddressWindow" Style="{StaticResource DialogWindow}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:TunasDM.App.Localization"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{l:T 'Adresse aktualisieren'}" Icon="/Resources/TunasDownloadManager.ico" Width="620" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="True"
        FocusManager.FocusedElement="{Binding ElementName=UrlBox}">
    <DockPanel>
        <ui:TitleBar DockPanel.Dock="Top" Title="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" ShowMaximize="False" ShowMinimize="False" CanMaximize="False">
            <ui:TitleBar.Icon><ui:ImageIcon Source="/Resources/TunasLogo.png" /></ui:TitleBar.Icon>
        </ui:TitleBar>
    <StackPanel Margin="20">
        <TextBlock x:Name="NameText" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="StateText" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,3,0,0" />

        <Border Style="{StaticResource CardBorder}" Padding="14,12" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock Text="{l:T 'So geht es am einfachsten'}" FontWeight="SemiBold" />
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,4,0,10"
                           Text="{l:T 'Öffne die Seite, von der die Datei stammt, und klicke dort erneut auf den Download-Link. Solange dieses Fenster offen ist, übernimmt TUNAS den nächsten Download aus dem Browser als neue Adresse – mit Anmeldung (Cookies) – und lädt dort weiter, wo er stehen geblieben ist.'}" />
                <Button x:Name="OpenPageButton" Content="{l:T 'Download-Seite im Browser öffnen'}" Click="OnOpenPage" HorizontalAlignment="Left" />
            </StackPanel>
        </Border>

        <TextBlock Text="{l:T 'Neue Adresse'}" Style="{StaticResource Label}" Margin="0,16,0,6" />
        <TextBox x:Name="UrlBox" TextChanged="OnTextChanged" />
        <TextBlock x:Name="Hint" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                   Text="{l:T 'Oder die neue Adresse hier einfügen.'}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="{l:T 'Abbrechen'}" IsCancel="True" Margin="0,0,8,0" />
            <ui:Button Appearance="Primary" x:Name="OkButton" Content="{l:T 'Übernehmen und fortsetzen'}" IsDefault="True" IsEnabled="False" Click="OnOk" />
        </StackPanel>
    </StackPanel>
    </DockPanel>
</ui:FluentWindow>
