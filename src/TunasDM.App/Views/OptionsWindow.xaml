<ui:FluentWindow x:Class="TunasDM.App.Views.OptionsWindow" Style="{StaticResource DialogWindow}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:TunasDM.App.Localization"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{l:T 'Optionen'}" Icon="/Resources/TunasDownloadManager.ico" Width="760" Height="560" MinWidth="640" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel>
        <ui:TitleBar DockPanel.Dock="Top" Title="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" ShowMaximize="False" ShowMinimize="False" CanMaximize="False">
            <ui:TitleBar.Icon><ui:ImageIcon Source="/Resources/TunasLogo.png" /></ui:TitleBar.Icon>
        </ui:TitleBar>
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{l:T 'Abbrechen'}" IsCancel="True" Margin="0,0,8,0" />
            <ui:Button Appearance="Primary" Content="{l:T 'Speichern'}" IsDefault="True" Click="OnSave" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" x:Name="ErrorText" Foreground="{StaticResource Danger}" FontSize="12" Margin="0,10,0,0" Visibility="Collapsed" />

        <TabControl>
            <TabItem Header="{l:T 'Allgemein'}">
                <!-- Wie die Windows-11-Einstellungen: eine Karte pro Schalter -->
                <StackPanel Margin="0,8,0,0">
                    <ui:CardControl Margin="0,0,0,6" Icon="{ui:SymbolIcon LocalLanguage24}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <TextBlock Text="Sprache · Language" FontSize="14" />
                                <TextBlock Text="{l:T 'Gilt nach einem Neustart von TUNAS'}" FontSize="12" Foreground="{StaticResource TextMuted}" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ComboBox x:Name="LanguageBox" Width="200" />
                    </ui:CardControl>
                    <ui:CardControl Margin="0,0,0,6" Icon="{ui:SymbolIcon DarkTheme24}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <TextBlock Text="{l:T 'Design'}" FontSize="14" />
                                <TextBlock Text="{l:T 'Schwarz-weiß, dunkel oder hell; gilt nach einem Neustart von TUNAS'}" FontSize="12" Foreground="{StaticResource TextMuted}" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ComboBox x:Name="ThemeBox" Width="200" />
                    </ui:CardControl>
                    <ui:CardControl Margin="0,0,0,6" Icon="{ui:SymbolIcon Power24}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <TextBlock Text="{l:T 'Mit Windows starten'}" FontSize="14" />
                                <TextBlock Text="{l:T 'Startet unsichtbar im Infobereich'}" FontSize="12" Foreground="{StaticResource TextMuted}" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:ToggleSwitch x:Name="StartWithWindows" />
                    </ui:CardControl>
                    <ui:CardControl Margin="0,0,0,6" Icon="{ui:SymbolIcon ArrowMinimize24}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <TextBlock Text="{l:T 'Beim Schließen im Infobereich bleiben'}" FontSize="14" />
                                <TextBlock Text="{l:T 'Downloads laufen weiter, wenn das Fenster zu ist'}" FontSize="12" Foreground="{StaticResource TextMuted}" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:ToggleSwitch x:Name="MinimizeToTray" />
                    </ui:CardControl>
                    <ui:CardControl Margin="0,0,0,6" Icon="{ui:SymbolIcon ClipboardPaste24}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <TextBlock Text="{l:T 'Zwischenablage überwachen'}" FontSize="14" />
                                <TextBlock Text="{l:T 'Kopierte Download-Links sofort anbieten'}" FontSize="12" Foreground="{StaticResource TextMuted}" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:ToggleSwitch x:Name="MonitorClipboard" />
                    </ui:CardControl>
                    <ui:CardControl Margin="0,0,0,6" Icon="{ui:SymbolIcon DocumentSearch24}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <TextBlock Text="{l:T 'Download-Info vor dem Start'}" FontSize="14" />
                                <TextBlock Text="{l:T 'Name, Größe und Speicherort vor jedem Download bestätigen'}" FontSize="12" Foreground="{StaticResource TextMuted}" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:ToggleSwitch x:Name="ShowFileInfo" />
                    </ui:CardControl>
                    <ui:CardControl Margin="0,0,0,6" Icon="{ui:SymbolIcon ArrowDownload24}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <TextBlock Text="{l:T 'Fortschrittsfenster beim Start'}" FontSize="14" />
                                <TextBlock Text="{l:T 'Für jeden gestarteten Download ein eigenes Fenster mit Geschwindigkeit und Verbindungen'}" FontSize="12" Foreground="{StaticResource TextMuted}" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:ToggleSwitch x:Name="ShowProgress" />
                    </ui:CardControl>
                    <ui:CardControl Icon="{ui:SymbolIcon CheckmarkCircle24}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <TextBlock Text="{l:T 'Meldung nach dem Download'}" FontSize="14" />
                                <TextBlock Text="{l:T 'Fenster „Download abgeschlossen“ mit Öffnen und Ordner'}" FontSize="12" Foreground="{StaticResource TextMuted}" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:ToggleSwitch x:Name="ShowComplete" />
                    </ui:CardControl>
                    <ui:CardControl Margin="0,6,0,0" Icon="{ui:SymbolIcon ArrowSync24}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <TextBlock Text="{l:T 'Nach Updates suchen'}" FontSize="14" />
                                <TextBlock x:Name="UpdateStatus" FontSize="12" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:ToggleSwitch x:Name="CheckUpdates" />
                    </ui:CardControl>
                </StackPanel>
            </TabItem>

            <TabItem Header="{l:T 'Browser'}">
                <StackPanel>
                    <CheckBox x:Name="BrowserIntegration" Content="{l:T 'Downloads aus Chrome und Edge übernehmen (Dateitypen aus den Kategorien)'}" />
                    <TextBlock Text="{l:T 'Downloads von diesen Seiten behält der Browser (durch Leerzeichen getrennt, * als Platzhalter):'}"
                               Foreground="{StaticResource TextSecondary}" Margin="0,14,0,6" />
                    <TextBox x:Name="ExcludedSites" ToolTip="{l:T 'z. B. *.example.com intranet.local'}" />

                    <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock Text="{l:T 'Erweiterung'}" FontWeight="SemiBold" />
                            <DockPanel Margin="0,6,0,0">
                                <Button x:Name="RepairButton" DockPanel.Dock="Right" Content="{l:T 'Reparieren'}" Margin="12,0,0,0" VerticalAlignment="Top"
                                        ToolTip="{l:T 'Verbindungsdienst neu einrichten und bei Chrome, Edge und Firefox neu anmelden'}" Click="OnRepairBrowser" />
                                <TextBlock x:Name="BrowserStatus" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock x:Name="RepairResult" Visibility="Collapsed" Margin="0,8,0,0" TextWrapping="Wrap" LineHeight="20" />
                            <TextBlock Foreground="{StaticResource TextSecondary}" Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="20"
                                       Text="{l:T 'So wird sie installiert: In Chrome chrome://extensions bzw. in Edge edge://extensions öffnen, den Entwicklermodus einschalten, „Entpackte Erweiterung laden“ wählen und den Ordner unten angeben.'}" />
                            <DockPanel Margin="0,12,0,0">
                                <Button DockPanel.Dock="Right" Content="{l:T 'Ordner öffnen'}" Margin="8,0,0,0" Click="OnOpenExtensionFolder" />
                                <Button DockPanel.Dock="Right" Content="{l:T 'Pfad kopieren'}" Margin="8,0,0,0" Click="OnCopyExtensionFolder" />
                                <TextBox x:Name="ExtensionFolder" IsReadOnly="True" />
                            </DockPanel>
                            <TextBlock Foreground="{StaticResource TextSecondary}" Margin="0,14,0,0" TextWrapping="Wrap" LineHeight="20"
                                       Text="{l:T 'Firefox: about:debugging → „Dieser Firefox“ → „Temporäres Add-on laden“ und die Datei manifest.json im Ordner unten wählen (bis zum nächsten Firefox-Neustart).'}" />
                            <DockPanel Margin="0,12,0,0">
                                <Button DockPanel.Dock="Right" Content="{l:T 'Ordner öffnen'}" Margin="8,0,0,0" Click="OnOpenFirefoxFolder" />
                                <Button DockPanel.Dock="Right" Content="{l:T 'Pfad kopieren'}" Margin="8,0,0,0" Click="OnCopyFirefoxFolder" />
                                <TextBox x:Name="FirefoxFolder" IsReadOnly="True" />
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

            <TabItem Header="{l:T 'Video'}">
                <StackPanel Margin="0,8,0,0">
                    <ui:CardControl Margin="0,0,0,6" Icon="{ui:SymbolIcon Video24}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <TextBlock Text="{l:T '„Video laden“ über Videos zeigen'}" FontSize="14" />
                                <TextBlock Text="{l:T 'Erscheint im Browser oben rechts am Video'}" FontSize="12" Foreground="{StaticResource TextMuted}" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:ToggleSwitch x:Name="ShowVideoButton" />
                    </ui:CardControl>
                    <ui:CardControl Margin="0,0,0,6" Icon="{ui:SymbolIcon ArrowDownload24}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <TextBlock Text="{l:T 'yt-dlp'}" FontSize="14" />
                                <TextBlock x:Name="YtDlpStatus" Text="{l:T 'wird geprüft …'}" FontSize="12" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:Button x:Name="UpdateYtDlpButton" Content="{l:T 'Aktualisieren'}" Icon="{ui:SymbolIcon ArrowSync24}" Click="OnUpdateYtDlp" />
                    </ui:CardControl>
                    <ui:CardControl Icon="{ui:SymbolIcon FilmstripPlay24}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <TextBlock Text="{l:T 'ffmpeg'}" FontSize="14" />
                                <TextBlock x:Name="FfmpegStatus" FontSize="12" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:Button x:Name="SetupToolsButton" Content="{l:T 'Einrichten'}" Icon="{ui:SymbolIcon ArrowDownload24}" Click="OnSetupTools"
                                   ToolTip="{l:T 'yt-dlp und ffmpeg von GitHub laden (etwa 220 MB, mit Prüfsumme)'}" />
                    </ui:CardControl>
                    <TextBlock x:Name="ToolsFolderText" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="4,12,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </TabItem>

            <TabItem Header="{l:T 'Verbindung'}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="22" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="{l:T 'Verbindungen pro Datei'}" Style="{StaticResource Label}" />
                    <ComboBox Grid.Column="1" x:Name="Connections" />
                    <TextBlock Grid.Column="2" Text="{l:T 'Mehr als 8 belastet viele Server unnötig.'}" Foreground="{StaticResource TextMuted}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />

                    <TextBlock Grid.Row="2" Text="{l:T 'Gleichzeitige Downloads (Warteschlange)'}" Style="{StaticResource Label}" />
                    <ComboBox Grid.Row="2" Grid.Column="1" x:Name="Parallel" />

                    <TextBlock Grid.Row="4" Text="{l:T 'Geschwindigkeitslimit pro Sekunde'}" Style="{StaticResource Label}" />
                    <TextBox Grid.Row="4" Grid.Column="1" x:Name="SpeedLimit" />
                    <TextBlock Grid.Row="4" Grid.Column="2" Text="{l:T 'z. B. 500K oder 2M; 0 = unbegrenzt'}" Foreground="{StaticResource TextMuted}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />

                    <CheckBox Grid.Row="6" Grid.ColumnSpan="3" x:Name="IgnoreModified"
                              Content="{l:T 'Änderungszeit des Servers beim Fortsetzen ignorieren (für Server, die sie bei jeder Anfrage neu setzen)'}" />

                    <TextBlock Grid.Row="8" Text="{l:T 'Proxy'}" Style="{StaticResource Label}" />
                    <ComboBox Grid.Row="8" Grid.Column="1" x:Name="ProxyModeBox" SelectionChanged="OnProxyModeChanged">
                        <ComboBoxItem Content="{l:T 'Wie Windows'}" />
                        <ComboBoxItem Content="{l:T 'Kein Proxy'}" />
                        <ComboBoxItem Content="{l:T 'Eigener Proxy'}" />
                    </ComboBox>
                    <TextBlock Grid.Row="8" Grid.Column="2" Text="{l:T 'Gilt für Downloads und Videos (yt-dlp).'}" Foreground="{StaticResource TextMuted}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />

                    <TextBlock Grid.Row="10" Text="{l:T 'Proxy-Adresse'}" Style="{StaticResource Label}" />
                    <TextBox Grid.Row="10" Grid.Column="1" Grid.ColumnSpan="2" x:Name="ProxyAddressBox" />
                    <TextBlock Grid.Row="11" Grid.Column="1" Grid.ColumnSpan="2" Text="{l:T 'z. B. proxy.firma.de:8080 oder socks5://127.0.0.1:1080'}" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,4,0,0" />

                    <TextBlock Grid.Row="12" Text="{l:T 'Anmeldung (falls nötig)'}" Style="{StaticResource Label}" Margin="0,10,0,0" />
                    <Grid Grid.Row="12" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox x:Name="ProxyUserBox" PlaceholderText="{l:T 'Benutzer'}" />
                        <ui:PasswordBox Grid.Column="2" x:Name="ProxyPasswordBox" PlaceholderText="{l:T 'Passwort'}" />
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="{l:T 'Speichern'}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{l:T 'Download-Ordner'}" Style="{StaticResource Label}" />
                        <TextBox Grid.Column="1" x:Name="DownloadsFolder" />
                        <Button Grid.Column="2" Content="…" Width="36" Padding="0" Margin="8,0,0,0" Click="OnBrowseDownloads" />
                    </Grid>

                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="{l:T 'Kategorie hinzufügen'}" Click="OnAddCategory" Padding="10,4" />
                        <TextBlock Text="{l:T 'Kategorien: Endungen durch Leerzeichen trennen. Ohne eigenen Ordner wird ein Unterordner angelegt.'}"
                                   Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </DockPanel>

                    <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="CategoryList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="190" />
                                                <ColumnDefinition Width="36" />
                                                <ColumnDefinition Width="36" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsGeneral}" Margin="0,0,6,0" />
                                            <TextBox Grid.Column="1" Text="{Binding Extensions, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0"
                                                     IsReadOnly="{Binding IsGeneral}" ToolTip="{l:T 'Dateiendungen dieser Kategorie'}" />
                                            <TextBox Grid.Column="2" Text="{Binding Folder, UpdateSourceTrigger=PropertyChanged}" ToolTip="{l:T 'Eigener Ordner (leer = Unterordner)'}" />
                                            <Button Grid.Column="3" Content="…" Width="30" Padding="0" Margin="6,0,0,0" Click="OnBrowseCategory" />
                                            <ui:Button Grid.Column="4" Icon="{ui:SymbolIcon Delete24}" Width="30" Padding="0" Margin="6,0,0,0"
                                                    Click="OnRemoveCategory" ToolTip="{l:T 'Kategorie entfernen'}"
                                                    Visibility="{Binding IsGeneral, Converter={StaticResource InverseBoolToVisibility}}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
    </DockPanel>
</ui:FluentWindow>
