<ui:FluentWindow x:Class="TunasDM.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:TunasDM.App.Localization"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:TunasDM.App.ViewModels"
        xmlns:controls="clr-namespace:TunasDM.App.Controls"
        xmlns:core="clr-namespace:TunasDM.Core.Management;assembly=TunasDM.Core"
        Title="{l:T 'TUNAS Download Manager'}" Icon="/Resources/TunasDownloadManager.ico"
        Width="1240" Height="780" MinWidth="960" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round"
        AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">

    <Window.TaskbarItemInfo>
        <TaskbarItemInfo ProgressState="{Binding TaskbarState}" ProgressValue="{Binding TaskbarProgress}" />
    </Window.TaskbarItemInfo>

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding AddUrlCommand}" />
        <KeyBinding Key="Delete" Command="{Binding DeleteCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Titelleiste mit Logo -->
        <ui:TitleBar Grid.Row="0" Title="{l:T 'TUNAS Download Manager'}">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="/Resources/TunasLogo.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Werkzeugleiste, plus Suche und Gesamtgeschwindigkeit -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="12,0,12,10" Padding="6">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <ui:Button Appearance="Primary" Command="{Binding AddUrlCommand}" Padding="14,6" MinWidth="80" Margin="0,0,8,0"
                               ToolTip="{l:T 'Neuen Download hinzufügen (Strg+N)'}" AutomationProperties.Name="Neuen Download hinzufügen">
                        <StackPanel>
                            <ui:SymbolIcon Symbol="Add24" FontSize="20" HorizontalAlignment="Center" />
                            <TextBlock Text="{l:T 'Neu'}" Style="{StaticResource ToolLabel}" />
                        </StackPanel>
                    </ui:Button>
                    <ui:Button Style="{StaticResource ToolButton}" Command="{Binding ResumeCommand}" ToolTip="{l:T 'Ausgewählte Downloads starten oder fortsetzen'}">
                        <StackPanel><ui:SymbolIcon Symbol="Play24" FontSize="20" HorizontalAlignment="Center" /><TextBlock Text="{l:T 'Fortsetzen'}" Style="{StaticResource ToolLabel}" /></StackPanel>
                    </ui:Button>
                    <ui:Button Style="{StaticResource ToolButton}" Command="{Binding PauseCommand}" ToolTip="{l:T 'Ausgewählte Downloads pausieren'}">
                        <StackPanel><ui:SymbolIcon Symbol="Pause24" FontSize="20" HorizontalAlignment="Center" /><TextBlock Text="{l:T 'Pausieren'}" Style="{StaticResource ToolLabel}" /></StackPanel>
                    </ui:Button>
                    <ui:Button Style="{StaticResource ToolButton}" Command="{Binding PauseAllCommand}" ToolTip="{l:T 'Alle Downloads anhalten und die Warteschlange stoppen'}">
                        <StackPanel><ui:SymbolIcon Symbol="Stop24" FontSize="20" HorizontalAlignment="Center" /><TextBlock Text="{l:T 'Alle stoppen'}" Style="{StaticResource ToolLabel}" /></StackPanel>
                    </ui:Button>
                    <ui:Button Style="{StaticResource ToolButton}" Command="{Binding DeleteCommand}" ToolTip="{l:T 'Aus der Liste entfernen (Entf)'}">
                        <StackPanel><ui:SymbolIcon Symbol="Delete24" FontSize="20" HorizontalAlignment="Center" /><TextBlock Text="{l:T 'Entfernen'}" Style="{StaticResource ToolLabel}" /></StackPanel>
                    </ui:Button>
                    <Border Width="1" Background="{StaticResource BorderBrush}" Margin="6,8" />
                    <ui:Button Style="{StaticResource ToolButton}" Command="{Binding StartQueueCommand}" ToolTip="{l:T 'Gewählte Warteschlange starten (sonst die Hauptwarteschlange)'}">
                        <StackPanel><ui:SymbolIcon Symbol="TextBulletListLtr24" FontSize="20" HorizontalAlignment="Center" /><TextBlock Text="{l:T 'Queue starten'}" Style="{StaticResource ToolLabel}" /></StackPanel>
                    </ui:Button>
                    <ui:Button Style="{StaticResource ToolButton}" Command="{Binding StopQueueCommand}" ToolTip="{l:T 'Alle Warteschlangen anhalten'}">
                        <StackPanel><ui:SymbolIcon Symbol="RecordStop24" FontSize="20" HorizontalAlignment="Center" /><TextBlock Text="{l:T 'Queue stoppen'}" Style="{StaticResource ToolLabel}" /></StackPanel>
                    </ui:Button>
                    <ui:Button Style="{StaticResource ToolButton}" Command="{Binding ShowSchedulerCommand}" ToolTip="{l:T 'Warteschlangen und Zeitplan'}">
                        <StackPanel><ui:SymbolIcon Symbol="CalendarClock24" FontSize="20" HorizontalAlignment="Center" /><TextBlock Text="{l:T 'Zeitplaner'}" Style="{StaticResource ToolLabel}" /></StackPanel>
                    </ui:Button>
                    <ui:Button Style="{StaticResource ToolButton}" Command="{Binding ShowGrabberCommand}" ToolTip="{l:T 'Site-Grabber: eine Website nach Dateien durchsuchen'}">
                        <StackPanel><ui:SymbolIcon Symbol="GlobeSearch24" FontSize="20" HorizontalAlignment="Center" /><TextBlock Text="{l:T 'Grabber'}" Style="{StaticResource ToolLabel}" /></StackPanel>
                    </ui:Button>
                    <ui:Button Style="{StaticResource ToolButton}" Click="OnListMenu" ToolTip="{l:T 'Link-Listen importieren oder die Download-Liste exportieren (IDM .ef2 oder Text)'}">
                        <StackPanel><ui:SymbolIcon Symbol="ArrowSwap24" FontSize="20" HorizontalAlignment="Center" /><TextBlock Text="{l:T 'Liste'}" Style="{StaticResource ToolLabel}" /></StackPanel>
                        <ui:Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{l:T 'Importieren …'}" Command="{Binding ImportListCommand}" Icon="{ui:SymbolIcon ArrowImport24}" />
                                <MenuItem Header="{l:T 'Exportieren …'}" Command="{Binding ExportListCommand}" Icon="{ui:SymbolIcon ArrowExportLtr24}" />
                            </ContextMenu>
                        </ui:Button.ContextMenu>
                    </ui:Button>
                    <Border Width="1" Background="{StaticResource BorderBrush}" Margin="6,8" />
                    <ui:Button Style="{StaticResource ToolButton}" Command="{Binding OptionsCommand}" ToolTip="{l:T 'Einstellungen'}">
                        <StackPanel><ui:SymbolIcon Symbol="Settings24" FontSize="20" HorizontalAlignment="Center" /><TextBlock Text="{l:T 'Optionen'}" Style="{StaticResource ToolLabel}" /></StackPanel>
                    </ui:Button>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0"
                                Visibility="{Binding SpeedText, Converter={StaticResource NullToVisibility}}">
                        <ui:SymbolIcon Symbol="TopSpeed24" FontSize="18" Foreground="{StaticResource TextSecondary}" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding SpeedText}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <ui:TextBox x:Name="SearchBox" Width="260" PlaceholderText="{l:T 'Downloads durchsuchen (Strg+F)'}" ClearButtonEnabled="True"
                                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                        <ui:TextBox.Icon>
                            <ui:SymbolIcon Symbol="Search24" />
                        </ui:TextBox.Icon>
                    </ui:TextBox>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Baum links, Liste rechts -->
        <Grid Grid.Row="2" Margin="12,0,12,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="4,6">
                <TreeView x:Name="Tree" ItemsSource="{Binding Filters}" Background="Transparent" BorderThickness="0"
                          SelectedItemChanged="OnTreeSelected">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="{x:Type TreeViewItem}" BasedOn="{StaticResource DefaultTreeViewItemStyle}">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate DataType="{x:Type vm:FilterViewModel}" ItemsSource="{Binding Children}">
                            <DockPanel MinWidth="150">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" Foreground="{StaticResource TextMuted}" FontSize="12"
                                           VerticalAlignment="Center" Margin="10,0,4,0" />
                                <ui:SymbolIcon Symbol="{Binding Symbol}" FontSize="16" Margin="0,0,10,0" Foreground="{StaticResource TextSecondary}" />
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardBorder}" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Spaltenköpfe: Klick sortiert -->
                    <Grid Grid.Row="0" Margin="14,6,14,2" TextElement.Foreground="{StaticResource TextMuted}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="210" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <ui:Button Grid.Column="1" Appearance="Transparent" BorderThickness="0" Padding="4,2" Content="{l:T 'Name'}"
                                   Command="{Binding SortByCommand}" CommandParameter="Name" FontSize="12" />
                        <ui:Button Grid.Column="2" Appearance="Transparent" BorderThickness="0" Padding="4,2" Content="{l:T 'Fortschritt'}"
                                   Command="{Binding SortByCommand}" CommandParameter="Status" FontSize="12" />
                        <!-- Weitere Sortierungen, die keine eigene Spalte haben -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right">
                            <ui:Button Appearance="Transparent" BorderThickness="0" Padding="4,2" Content="{l:T 'Größe'}" ToolTip="{l:T 'Nach Größe sortieren'}"
                                       Command="{Binding SortByCommand}" CommandParameter="TotalSize" FontSize="12" />
                            <ui:Button Appearance="Transparent" BorderThickness="0" Padding="4,2" Content="{l:T 'Datum'}" ToolTip="{l:T 'Nach Datum sortieren'}"
                                       Command="{Binding SortByCommand}" CommandParameter="AddedAt" FontSize="12" />
                        </StackPanel>
                    </Grid>

                    <ui:ListView x:Name="List" Grid.Row="1" ItemsSource="{Binding ItemsView}" SelectedItem="{Binding SelectedItem}" SelectionMode="Extended"
                              Background="Transparent" BorderThickness="0" Padding="6,0,6,6"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              SelectionChanged="OnSelectionChanged" MouseDoubleClick="OnDoubleClick">
                        <ui:ListView.ContextMenu>
                            <ContextMenu x:Name="RowMenu">
                                <MenuItem Header="{l:T 'Öffnen'}" Command="{Binding OpenFileCommand}" Icon="{ui:SymbolIcon Open24}" />
                                <MenuItem Header="{l:T 'Ordner öffnen'}" Command="{Binding OpenFolderCommand}" Icon="{ui:SymbolIcon FolderOpen24}" />
                                <MenuItem Header="{l:T 'Details und Verbindungen'}" Command="{Binding ShowDetailsCommand}" Icon="{ui:SymbolIcon Info24}" />
                                <Separator />
                                <MenuItem Header="{l:T 'Fortsetzen'}" Command="{Binding ResumeCommand}" Icon="{ui:SymbolIcon Play24}" />
                                <MenuItem Header="{l:T 'Pausieren'}" Command="{Binding PauseCommand}" Icon="{ui:SymbolIcon Pause24}" />
                                <MenuItem Header="{l:T 'In Warteschlange'}" Icon="{ui:SymbolIcon TextBulletListLtr24}" ItemsSource="{Binding QueueChoices}">
                                    <MenuItem.ItemContainerStyle>
                                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                            <Setter Property="Header" Value="{Binding DisplayName}" />
                                            <Setter Property="Command" Value="{Binding DataContext.EnqueueToCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <Setter Property="CommandParameter" Value="{Binding}" />
                                        </Style>
                                    </MenuItem.ItemContainerStyle>
                                </MenuItem>
                                <MenuItem Header="{l:T 'Neu laden'}" Command="{Binding RestartCommand}" Icon="{ui:SymbolIcon ArrowClockwise24}" />
                                <Separator />
                                <MenuItem Header="{l:T 'Adresse kopieren'}" Command="{Binding CopyUrlCommand}" Icon="{ui:SymbolIcon Copy24}" />
                                <MenuItem Header="{l:T 'Adresse aktualisieren …'}" Command="{Binding UpdateAddressCommand}" Icon="{ui:SymbolIcon LinkEdit24}" />
                                <Separator />
                                <MenuItem Header="{l:T 'Aus der Liste entfernen'}" Command="{Binding DeleteCommand}" Icon="{ui:SymbolIcon Dismiss24}" />
                                <MenuItem Header="{l:T 'Entfernen und Datei löschen'}" Command="{Binding DeleteWithFileCommand}" Icon="{ui:SymbolIcon Delete24}" />
                            </ContextMenu>
                        </ui:ListView.ContextMenu>
                        <ui:ListView.ItemContainerStyle>
                            <Style TargetType="{x:Type ui:ListViewItem}" BasedOn="{StaticResource {x:Type ui:ListViewItem}}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="8,8" />
                                <Setter Property="Margin" Value="0,1" />
                            </Style>
                        </ui:ListView.ItemContainerStyle>
                        <ui:ListView.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DownloadItemViewModel}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="210" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="34" Height="34" CornerRadius="8" Background="{StaticResource PanelAlt}" HorizontalAlignment="Left">
                                        <ui:SymbolIcon Symbol="{Binding Symbol}" FontSize="18" />
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis" ToolTip="{Binding Url}" />
                                        <TextBlock x:Name="Sub" Text="{Binding SubText}" FontSize="12" Foreground="{StaticResource TextMuted}"
                                                   Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <ProgressBar x:Name="Bar" Height="4" Maximum="100" Value="{Binding Percent, Mode=OneWay}"
                                                     Visibility="{Binding ShowsBar, Converter={StaticResource BoolToVisibility}}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                            <ui:SymbolIcon x:Name="DoneIcon" Symbol="CheckmarkCircle24" FontSize="14" Foreground="{StaticResource Green}"
                                                           Margin="0,0,6,0" Visibility="Collapsed" />
                                            <TextBlock x:Name="ProgressLabel" Text="{Binding ProgressText}" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Aktionen beim Überfahren oder bei Auswahl -->
                                    <StackPanel x:Name="Actions" Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" Visibility="Hidden">
                                        <ui:Button x:Name="ToggleButton" Style="{StaticResource RowButton}" ToolTip="{l:T 'Pausieren / Fortsetzen'}"
                                                   Command="{Binding DataContext.ToggleRowCommand, RelativeSource={RelativeSource AncestorType=ui:ListView}}"
                                                   CommandParameter="{Binding}">
                                            <ui:SymbolIcon x:Name="ToggleIcon" Symbol="Pause24" FontSize="16" />
                                        </ui:Button>
                                        <ui:Button Style="{StaticResource RowButton}" ToolTip="{l:T 'Ordner öffnen'}"
                                                   Command="{Binding DataContext.OpenFolderRowCommand, RelativeSource={RelativeSource AncestorType=ui:ListView}}"
                                                   CommandParameter="{Binding}">
                                            <ui:SymbolIcon Symbol="FolderOpen24" FontSize="16" />
                                        </ui:Button>
                                        <ui:Button Style="{StaticResource RowButton}" ToolTip="{l:T 'Weitere Aktionen'}" Click="OnMoreClick">
                                            <ui:SymbolIcon Symbol="MoreHorizontal24" FontSize="16" />
                                        </ui:Button>
                                    </StackPanel>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ui:ListViewItem}}" Value="True">
                                        <Setter TargetName="Actions" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ui:ListViewItem}}" Value="True">
                                        <Setter TargetName="Actions" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsActive}" Value="False">
                                        <Setter TargetName="ToggleIcon" Property="Symbol" Value="Play24" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static core:DownloadStatus.Queued}">
                                        <Setter TargetName="ToggleIcon" Property="Symbol" Value="Pause24" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static core:DownloadStatus.Completed}">
                                        <Setter TargetName="ToggleIcon" Property="Symbol" Value="Open24" />
                                        <Setter TargetName="ToggleButton" Property="ToolTip" Value="Öffnen" />
                                        <Setter TargetName="DoneIcon" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="ProgressLabel" Property="Foreground" Value="{StaticResource Green}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static core:DownloadStatus.Error}">
                                        <Setter TargetName="ProgressLabel" Property="Foreground" Value="{StaticResource Danger}" />
                                        <Setter TargetName="Sub" Property="Foreground" Value="{StaticResource Danger}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ui:ListView.ItemTemplate>
                    </ui:ListView>

                    <!-- Leere Liste -->
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                Visibility="{Binding HasItems, Converter={StaticResource InverseBoolToVisibility}}">
                        <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="44" HorizontalAlignment="Center" Foreground="{StaticResource TextMuted}" />
                        <TextBlock Text="{l:T 'Noch keine Downloads'}" FontSize="18" HorizontalAlignment="Center" Margin="0,14,0,6" />
                        <TextBlock Text="{l:T 'Auf „Neu“ klicken, einen Link hierher ziehen oder im Browser „Mit TUNAS laden“ wählen.'}"
                                   Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Details zur Auswahl -->
        <Border Grid.Row="3" Style="{StaticResource CardBorder}" Margin="12,0,12,10" Padding="16,12"
                Visibility="{Binding SelectedItem, Converter={StaticResource NullToVisibility}}">
            <StackPanel DataContext="{Binding SelectedItem}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}" Foreground="{StaticResource TextSecondary}" />
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <controls:SegmentBar Height="10" Margin="0,10,0,10" Progress="{Binding Progress}" />
                <TextBlock Text="{Binding DetailText}" Foreground="{StaticResource TextSecondary}" FontSize="12" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Location}" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>

        <!-- Statuszeile -->
        <DockPanel Grid.Row="4" Margin="18,0,18,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Ellipse x:Name="QueueDot" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{StaticResource TextMuted}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding QueueRunning}" Value="True">
                                    <Setter Property="Fill" Value="{StaticResource Green}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding QueueStatusText}" Foreground="{StaticResource TextSecondary}" FontSize="12" />
            </StackPanel>
            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextSecondary}" FontSize="12" />
        </DockPanel>
    </Grid>
</ui:FluentWindow>
