<ui:FluentWindow x:Class="TunasDM.App.Views.MediaWindow" Style="{StaticResource DialogWindow}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:TunasDM.App.Localization"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:media="clr-namespace:TunasDM.Core.Media;assembly=TunasDM.Core"
        Title="{l:T 'Video laden'}" Icon="/Resources/TunasDownloadManager.ico" Width="640" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Topmost="True">
    <StackPanel>
        <ui:TitleBar Title="{l:T 'Video laden'}" ShowMaximize="False" ShowMinimize="False" CanMaximize="False">
            <ui:TitleBar.Icon><ui:ImageIcon Source="/Resources/TunasLogo.png" /></ui:TitleBar.Icon>
        </ui:TitleBar>

        <StackPanel Margin="20,4,20,20">
            <!-- Kopf: Vorschaubild, Titel, Seite und Dauer -->
            <DockPanel Margin="0,0,0,16">
                <Border DockPanel.Dock="Left" Width="176" Height="99" CornerRadius="8" Background="{StaticResource PanelAlt}" Margin="0,0,16,0" ClipToBounds="True">
                    <Grid>
                        <ui:SymbolIcon Symbol="Video24" FontSize="30" Foreground="{StaticResource TextMuted}" />
                        <Image x:Name="Thumbnail" Stretch="UniformToFill" />
                    </Grid>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Text="{l:T 'Video wird gesucht …'}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="44" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="MetaText" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>

            <!-- Laden / Fehler -->
            <StackPanel x:Name="LoadingPanel" Orientation="Horizontal" Margin="0,8,0,16">
                <ui:ProgressRing IsIndeterminate="True" Width="22" Height="22" />
                <TextBlock x:Name="LoadingText" Text="{l:T 'Qualitäten werden abgefragt …'}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="12,0,0,0" />
            </StackPanel>
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource Danger}" TextWrapping="Wrap" Margin="0,0,0,14" Visibility="Collapsed" />

            <!-- Erster Start: yt-dlp und ffmpeg fehlen noch -->
            <DockPanel x:Name="SetupPanel" Margin="0,0,0,16" Visibility="Collapsed">
                <ui:Button DockPanel.Dock="Right" Appearance="Primary" Content="{l:T 'Jetzt einrichten'}" Icon="{ui:SymbolIcon ArrowDownload24}"
                           Margin="16,0,0,0" VerticalAlignment="Center" Click="OnSetupTools" />
                <TextBlock TextWrapping="Wrap" VerticalAlignment="Center"
                           Text="{l:T 'Für Videos braucht TUNAS die Werkzeuge yt-dlp und ffmpeg. Sie werden einmalig von GitHub geladen (etwa 220 MB) und geprüft.'}" />
            </DockPanel>

            <!-- Qualitäten -->
            <TextBlock x:Name="OptionsLabel" Text="{l:T 'Qualität'}" Style="{StaticResource SectionTitle}" Margin="2,0,0,6" Visibility="Collapsed" />
            <ListBox x:Name="Options" MaxHeight="260" Visibility="Collapsed" SelectionChanged="OnOptionChanged"
                     Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type media:MediaOption}">
                        <DockPanel Margin="2,2">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding EstimatedSize, Converter={StaticResource SizeText}}"
                                       Opacity="0.8" VerticalAlignment="Center" Margin="12,0,4,0" />
                            <ui:SymbolIcon x:Name="Icon" Symbol="Video24" FontSize="18" Margin="0,0,12,0" />
                            <StackPanel>
                                <TextBlock Text="{Binding Label}" FontSize="14" />
                                <TextBlock Text="{Binding Detail}" FontSize="12" Opacity="0.7" />
                            </StackPanel>
                        </DockPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsAudio}" Value="True">
                                <Setter TargetName="Icon" Property="Symbol" Value="MusicNote224" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Ziel -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{l:T 'Speichern in'}" Style="{StaticResource Label}" />
                <ui:TextBox Grid.Column="1" x:Name="FolderBox" />
                <ui:Button Grid.Column="2" Content="…" Width="40" Margin="8,0,0,0" Click="OnBrowse" ToolTip="{l:T 'Ordner wählen'}" />
                <TextBlock Grid.Row="2" Text="{l:T 'Dateiname'}" Style="{StaticResource Label}" />
                <ui:TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" x:Name="NameBox" />
            </Grid>

            <DockPanel Margin="0,20,0,0">
                <ui:Button DockPanel.Dock="Left" Content="{l:T 'Abbrechen'}" IsCancel="True" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button x:Name="LaterButton" Content="{l:T 'Später laden'}" Margin="0,0,8,0" Click="OnLater" IsEnabled="False" />
                    <ui:Button x:Name="StartButton" Appearance="Primary" Content="{l:T 'Herunterladen'}" Icon="{ui:SymbolIcon ArrowDownload24}"
                               IsDefault="True" Click="OnStart" IsEnabled="False" />
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
