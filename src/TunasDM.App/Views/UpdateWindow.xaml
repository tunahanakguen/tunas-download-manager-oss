<ui:FluentWindow x:Class="TunasDM.App.Views.UpdateWindow" Style="{StaticResource DialogWindow}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:TunasDM.App.Localization"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{l:T 'Update verfügbar'}" Icon="/Resources/TunasDownloadManager.ico" Width="560" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" ShowInTaskbar="True">
    <DockPanel>
        <ui:TitleBar DockPanel.Dock="Top" Title="{l:T 'Update verfügbar'}" ShowMaximize="False" ShowMinimize="False" CanMaximize="False">
            <ui:TitleBar.Icon><ui:ImageIcon Source="/Resources/TunasLogo.png" /></ui:TitleBar.Icon>
        </ui:TitleBar>
        <StackPanel Margin="20,4,20,20">
            <DockPanel Margin="0,0,0,14">
                <Image DockPanel.Dock="Left" Source="/Resources/TunasLogo.png" Width="56" Height="56" Margin="0,0,16,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="HeadText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="SubText" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>

            <TextBlock Text="{l:T 'Neu in dieser Version'}" Style="{StaticResource SectionTitle}" Margin="2,0,0,6" />
            <TextBox x:Name="NotesBox" IsReadOnly="True" TextWrapping="Wrap" MinHeight="80" MaxHeight="220"
                     VerticalScrollBarVisibility="Auto" BorderThickness="1" Padding="8" />

            <StackPanel x:Name="ProgressPanel" Margin="0,14,0,0" Visibility="Collapsed">
                <TextBlock x:Name="ProgressText" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6" />
                <ProgressBar x:Name="Bar" Height="4" Maximum="1" />
            </StackPanel>
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource Danger}" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed" />

            <DockPanel Margin="0,20,0,0">
                <ui:Button x:Name="SkipButton" DockPanel.Dock="Left" Content="{l:T 'Diese Version überspringen'}" Click="OnSkip" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button x:Name="LaterButton" Content="{l:T 'Später'}" IsCancel="True" Margin="0,0,8,0" Click="OnLater" />
                    <ui:Button x:Name="InstallButton" Appearance="Primary" Content="{l:T 'Jetzt aktualisieren'}" Icon="{ui:SymbolIcon ArrowDownload24}"
                               IsDefault="True" Click="OnInstall" />
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </DockPanel>
</ui:FluentWindow>
